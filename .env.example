# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth 会话加密密钥
# 可留空 —— 容器首次启动会自动生成强随机密钥并保存到数据卷 ./data/.nextauth_secret
# 多实例部署请显式设置为固定值，生成方式：openssl rand -base64 32
NEXTAUTH_SECRET=""

# 初始管理员密码（仅在管理员账号不存在时生效）
# 可留空 —— 留空时首次启动自动生成强随机密码，
#   并在「启动日志」和 ./data/initial-admin-credentials.txt 中显示
# 若想自己指定，填写一个足够强的密码（首次登录后系统仍会强制要求修改）
# 忘记密码时，在容器内执行：node /app/dist-scripts/scripts/seed-admin.js --reset-password
DEFAULT_ADMIN_PASSWORD=""

# 初始管理员登录邮箱（默认 admin@localhost）
DEFAULT_ADMIN_EMAIL="admin@localhost"

# 自动生成的初始凭据落盘位置（可选，默认 /app/data/initial-admin-credentials.txt）
ADMIN_CREDENTIALS_FILE="/app/data/initial-admin-credentials.txt"

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# 生产环境如果使用 Docker 且 IP 不固定，建议注释掉此项并启用 AUTH_TRUST_HOST
# NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 设置为 true 时，NextAuth 会根据请求头自动推断 URL，适合 Docker/PaaS 环境
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────
# AI 服务配置已迁移到 Python 后端（python-backend/.env.example）。
# 前端不再读取任何 AI 相关变量（AI_PROVIDER / OPENAI_* / GOOGLE_* 等）。
# ─────────────────────────────────────────────

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# 本地 OCR
# OCR 已迁移到 Python 后端（rapidocr + onnxruntime，PP-OCR 中文模型），
# 前端不再需要任何 OCR 相关变量，也不再依赖 @gutenye/ocr-node / onnxruntime-node。
# 想关闭 Python 侧 OCR：在构建后端镜像时加 --build-arg WITH_OCR=false
# （关闭后 POST /api/ocr 会返回 503 OCR_NOT_INSTALLED，其余功能不受影响）。

# ============================================================
# Docker Compose 双服务部署（Next.js 前端 + Python FastAPI 后端）
# 以下变量由 docker-compose.yml 读取；复制到 .env 后按需修改
# ============================================================

# Python 后端地址。compose 内网用服务名；本机直连调试用 http://localhost:8000
PYTHON_BACKEND_URL=http://backend:8000

# 是否启用 Next.js → FastAPI 的 catch-all 转发。
# 必须为 true，否则前端所有 /api/* 会返回 404（代理未启用）
PYTHON_PROXY_ENABLED=true

# 后端 JWT 密钥（生产必填，compose 里缺失会直接报错拒绝启动）
# 生成：openssl rand -base64 48
JWT_SECRET_KEY=

# 后端是否信任前端注入的 X-Forwarded-User 身份头。
# true = 内网桥接模式（后端不暴露公网时安全）
# 若把后端 8000 端口暴露到公网，必须设为 false 并改用 JWT 鉴权
TRUST_X_FORWARDED_USER=true

# 后端 CORS（浏览器只访问 3000，一般无需改动）
CORS_ORIGINS=http://localhost:3000
