# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth 会话加密密钥
# 可留空 —— 容器首次启动会自动生成强随机密钥并保存到数据卷 ./data/.nextauth_secret
# 多实例部署请显式设置为固定值，生成方式：openssl rand -base64 32
NEXTAUTH_SECRET=""

# 初始管理员密码（仅在管理员账号不存在时生效）
# 可留空 —— 留空时首次启动自动生成强随机密码，
#   并在「启动日志」和 ./data/initial-admin-credentials.txt 中显示
# 若想自己指定，填写一个足够强的密码（首次登录后系统仍会强制要求修改）
# 忘记密码时，在容器内执行：node /app/dist-scripts/scripts/seed-admin.js --reset-password
DEFAULT_ADMIN_PASSWORD=""

# 初始管理员登录邮箱（默认 admin@localhost）
DEFAULT_ADMIN_EMAIL="admin@localhost"

# 自动生成的初始凭据落盘位置（可选，默认 /app/data/initial-admin-credentials.txt）
ADMIN_CREDENTIALS_FILE="/app/data/initial-admin-credentials.txt"

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# 生产环境如果使用 Docker 且 IP 不固定，建议注释掉此项并启用 AUTH_TRUST_HOST
# NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 设置为 true 时，NextAuth 会根据请求头自动推断 URL，适合 Docker/PaaS 环境
AUTH_TRUST_HOST=true

# AI 服务提供商配置
# 可选值: "gemini" (默认) 或 "openai"
AI_PROVIDER="gemini"

# OpenAI 配置 (当 AI_PROVIDER="openai" 时需要)
OPENAI_API_KEY=""
OPENAI_BASE_URL="" # 可选，用于兼容的 API 服务
OPENAI_MODEL="gpt-4o" # 可选，默认为 gpt-4o

# Google Gemini 配置 (当 AI_PROVIDER="gemini" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL="http://localhost:8080"  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 本系统 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""

# 本地 OCR
# 默认使用内置引擎（@gutenye/ocr-node，PP-OCRv4 中文模型随 npm 包分发，
# onnxruntime-node 进程内推理，无需部署任何额外服务）
# 如需改用独立 OCR 服务（lw.PPOCR.OpenCVDNN），设置其地址即可：
#   Docker Compose: OCR_BASE_URL="http://ocr:8787" 并用 `docker compose --profile ocr up -d`
#   独立部署:       OCR_BASE_URL="http://127.0.0.1:8787"
OCR_BASE_URL=""

# 独立 OCR 服务的 API Key（可选，仅当服务端 http-service.json 配置了 api_key 时填写）
OCR_API_KEY=""

# 单次 OCR 请求超时（毫秒），仅对独立 OCR 服务生效，默认 20000，允许 1000~120000
OCR_TIMEOUT_MS=20000

# 内置引擎性能调优（可选）
# 检测前输入图最长边上限（px）：大图先缩放再推理，检测计算量按面积下降。
# 默认 1280（标准 PP-OCR 检测设计输入为最长边 960，1280 在速度与精度间更均衡）；0 = 关闭预缩放
OCR_DET_MAX_SIDE=1280

# 启动预热：服务启动即后台加载 OCR 模型并空跑一次，消除首次请求约 1.5s 冷启动。false = 关闭
OCR_WARMUP=true
