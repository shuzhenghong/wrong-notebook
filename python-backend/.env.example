# ====== 应用配置 ======
APP_NAME=Smart Wrong Notebook (Python)
APP_VERSION=1.0.0
DEBUG=true

# ====== 数据库 ======
DATABASE_URL=sqlite:///./wrong_notebook.db

# ====== 认证 ======
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ====== AI 服务 ======
# Provider: gemini | openai | azure
AI_PROVIDER=gemini

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ====== CORS ======
CORS_ORIGINS=*
