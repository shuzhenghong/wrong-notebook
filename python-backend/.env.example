# ====== 应用配置 ======
APP_NAME=Smart Wrong Notebook (Python)
APP_VERSION=1.0.0
DEBUG=true

# ====== 数据库 ======
DATABASE_URL=sqlite:///./wrong_notebook.db

# ====== 认证 ======
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ====== AI 服务 ======
# Provider: gemini | openai | azure
AI_PROVIDER=gemini

# Google Gemini
GOOGLE_API_KEY=
# gemini-1.5-* 已被 Google 下线；2.5 Flash 才支持下面的思考链预算控制
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ====== AI 成本控制（只省钱，不降能力）======
# 1) OCR 文本直通：前端本地 OCR 已给出题目文字时，直接让模型读文字，
#    不再把图片交给多模态模型 —— 图片 token 归零（通常占输入成本 60%~80%）。
#    off   始终走多模态（最保守）
#    auto  仅当 ocrText >= AI_OCR_TEXT_MIN_CHARS 时直通（默认，质量与成本折中）
#    force 只要有 ocrText 就直通
AI_OCR_TEXT_MODE=auto
AI_OCR_TEXT_MIN_CHARS=80

# 2) Gemini 2.5+ 思考链预算。2.5 默认开启动态思考，思考 token 按输出计费；
#    本任务是结构化抽取，不需要推理链，置 0 可省下大量输出 token 并明显提速。
#    用 gemini-1.5-* 时会自动跳过该参数。想保留思考链可调大（如 1024）。
GEMINI_THINKING_BUDGET=0

# 3) 分析结果缓存：同一张图 / 同一段文字 + 同参数 → 直接复用，零 token。
#    覆盖用户重试、双击、超时重发、同一张图换个笔记本再传等重复场景。
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SEC=900
AI_CACHE_MAX_ENTRIES=256

# ====== CORS ======
CORS_ORIGINS=*
